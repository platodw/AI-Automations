# ===========================================
# Daily Digest - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# ---- Authentication ----
# Password for dashboard login
DASHBOARD_PASSWORD=your_secure_password_here

# Secret for Vercel cron job authentication
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# ---- Google OAuth ----
# Create at: https://console.cloud.google.com/apis/credentials
# Required scopes: Gmail API, Google Calendar API
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/oauth/google/callback

# ---- OpenWeatherMap ----
# Sign up at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# ---- NewsAPI ----
# Sign up at: https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key

# ---- Anthropic ----
# Get at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# ---- Alpha Vantage (optional, stock data fallback) ----
# Sign up at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# ---- Discord ----
# Create bot at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_guild_id

# ---- Reddit ----
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# ---- App Configuration ----
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
DIGEST_RECIPIENT_EMAIL=platodw@gmail.com

# ---- Vercel Postgres ----
# Automatically set by Vercel when you create a Postgres database
# POSTGRES_URL=...
# POSTGRES_PRISMA_URL=...
# POSTGRES_URL_NO_SSL=...
# POSTGRES_URL_NON_POOLING=...
# POSTGRES_USER=...
# POSTGRES_HOST=...
# POSTGRES_PASSWORD=...
# POSTGRES_DATABASE=...
